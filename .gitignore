# ==========================================
# Root Monorepo .gitignore (360-Panorama)
# ==========================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Environment variables & secrets (NEVER commit secrets to git)
.env
.env.local
.env.*.local
.env.backup
.env.production
backend/.env
backend/.env.backup
backend/.env.production
frontend/.env
frontend/.env.local
frontend/.env.*.local
*.key
*.pem
*.cert

# Do NOT ignore environment template examples
!.env.example
!backend/.env.example
!frontend/.env.example

# Node / Frontend builds & dependencies
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# PHP / Backend dependencies
vendor/
backend/vendor/
composer.phar
backend/composer.phar

# Laravel runtime, caches and uploads
backend/storage/*.key
backend/storage/app/public/*
!backend/storage/app/public/.gitignore
backend/storage/framework/cache/data/*
!backend/storage/framework/cache/data/.gitignore
backend/storage/framework/cache/locks/*
!backend/storage/framework/cache/locks/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/framework/testing/*
!backend/storage/framework/testing/.gitignore
backend/storage/logs/*.log
!backend/storage/logs/.gitignore

# Laravel public generated files
backend/public/storage
backend/public/hot
backend/public/build

# Testing caches
.phpunit.result.cache
backend/.phpunit.result.cache
.phpunit.cache/
backend/.phpunit.cache/

# Databases & local volume dumps
*.sql
*.sqlite
*.sqlite-journal
mysql_data/

# IDE & Editor folders
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.zed/
.cursor/
.codex/
*.swp
*.swo
